# Typ2docx rhythm: double line spacing everywhere, APA style. The
# default lives on docDefaults; BodyText and Title get explicit pins
# because their own w:spacing would shadow the inherited line value.
# FirstParagraph loses its 240 boundary spacing and the caption
# cluster (Caption, TableCaption) loses its before/after spacing: APA
# adds no extra gap around headings, captions, or floats, and the
# values stacked with heading spacing and the two-paragraph caption
# split into inflated margins. Word attaches a paragraph's line lead
# below its text, so a caption before a table already shows a full
# lead; the cluster stays at zero and the gap is exactly one
# double-spaced lead. Compact (table cells, tight lists) and Figure
# (an image rides a text line, and the doubled line box showed as a
# giant gap below the image) pin single spacing.
--- a/word/styles.xml
+++ b/word/styles.xml
@@ -11,7 +11,7 @@
     </w:rPrDefault>
     <w:pPrDefault>
       <w:pPr>
-        <w:spacing w:after="200" />
+        <w:spacing w:after="200" w:line="480" w:lineRule="auto" />
       </w:pPr>
     </w:pPrDefault>
   </w:docDefaults>
@@ -26,7 +26,7 @@
     <w:link w:val="BodyTextChar" />
     <w:qFormat />
     <w:pPr>
-      <w:spacing w:before="180" w:after="180" />
+      <w:spacing w:before="180" w:after="180" w:line="480" w:lineRule="auto" />
       <w:ind w:firstLine="720" />
     </w:pPr>
   </w:style>
@@ -36,7 +36,7 @@
     <w:next w:val="BodyText" />
     <w:qFormat />
     <w:pPr>
-      <w:spacing w:before="240" />
+      <w:spacing w:before="0" w:line="480" w:lineRule="auto" />
     </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:customStyle="1" w:styleId="Compact">
@@ -44,7 +44,7 @@
     <w:basedOn w:val="BodyText" />
     <w:qFormat />
     <w:pPr>
-      <w:spacing w:before="36" w:after="36" />
+      <w:spacing w:before="36" w:after="36" w:line="240" w:lineRule="auto" />
       <w:ind w:firstLine="0" />
     </w:pPr>
   </w:style>
@@ -57,7 +57,7 @@
     <w:qFormat />
     <w:rsid w:val="00A10FD9" />
     <w:pPr>
-      <w:spacing w:after="80" w:line="240" w:lineRule="auto" />
+      <w:spacing w:after="80" w:line="480" w:lineRule="auto" />
       <w:contextualSpacing />
       <w:jc w:val="center" />
     </w:pPr>
@@ -625,7 +625,7 @@
     <w:basedOn w:val="Normal" />
     <w:link w:val="BodyTextChar" />
     <w:pPr>
-      <w:spacing w:before="0" w:after="120" />
+      <w:spacing w:before="0" w:after="0" />
     </w:pPr>
     <w:rPr>
       <w:i />
@@ -636,7 +636,7 @@
     <w:basedOn w:val="Caption" />
     <w:pPr>
       <w:keepNext />
-      <w:spacing w:before="240" />
+      <w:spacing w:before="0" />
     </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:customStyle="1" w:styleId="ImageCaption">
@@ -647,7 +647,7 @@
     <w:name w:val="Figure" />
     <w:basedOn w:val="Normal" />
     <w:pPr>
-      <w:spacing w:before="240" />
+      <w:spacing w:before="0" w:line="240" w:lineRule="auto" />
       <w:jc w:val="center" />
     </w:pPr>
   </w:style>
