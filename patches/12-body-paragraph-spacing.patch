# Typ2docx body spacing: no extra gap between paragraphs (pristine
# was 180/180); double line spacing already separates them, and the
# first-line indent marks the break. Boundary blocks (FirstParagraph
# after headings/tables, headings, captions) keep their spacing.
--- a/word/styles.xml
+++ b/word/styles.xml
@@ -26,7 +26,7 @@
     <w:link w:val="BodyTextChar" />
     <w:qFormat />
     <w:pPr>
-      <w:spacing w:before="180" w:after="180" w:line="480" w:lineRule="auto" />
+      <w:spacing w:before="0" w:after="0" w:line="480" w:lineRule="auto" />
       <w:ind w:firstLine="720" />
     </w:pPr>
   </w:style>
