# Every body paragraph gets a 0.5 in first-line indent and zero
# inter-paragraph spacing (the chosen typographic model). Compact (tight
# lists) suppresses the indent. Floats and block boundaries borrowed their
# separation from body paragraph spacing in the pristine stock, so they
# keep it explicitly: FirstParagraph before (below headings, tables,
# figures, lists, quotes), TableCaption and Figure before (above floats).
--- a/word/styles.xml
+++ b/word/styles.xml
@@ -26,7 +26,8 @@
     <w:link w:val="BodyTextChar" />
     <w:qFormat />
     <w:pPr>
-      <w:spacing w:before="180" w:after="180" />
+      <w:spacing w:before="0" w:after="0" />
+      <w:ind w:firstLine="720" />
     </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:customStyle="1" w:styleId="FirstParagraph">
@@ -34,6 +35,9 @@
     <w:basedOn w:val="BodyText" />
     <w:next w:val="BodyText" />
     <w:qFormat />
+    <w:pPr>
+      <w:spacing w:before="180" />
+    </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:customStyle="1" w:styleId="Compact">
     <w:name w:val="Compact" />
@@ -41,6 +45,7 @@
     <w:qFormat />
     <w:pPr>
       <w:spacing w:before="36" w:after="36" />
+      <w:ind w:firstLine="0" />
     </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:styleId="Title">
@@ -628,6 +633,7 @@
     <w:basedOn w:val="Caption" />
     <w:pPr>
       <w:keepNext />
+      <w:spacing w:before="180" />
     </w:pPr>
   </w:style>
   <w:style w:type="paragraph" w:customStyle="1" w:styleId="ImageCaption">
@@ -638,6 +644,7 @@
     <w:name w:val="Figure" />
     <w:basedOn w:val="Normal" />
     <w:pPr>
+      <w:spacing w:before="180" />
       <w:jc w:val="center" />
     </w:pPr>
   </w:style>
