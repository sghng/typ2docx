# Typ2docx change shading: ShadingBlock/ShadingInline give Word's
# fill-selection look (w:shd, covers display math). ShadingBlock keeps
# after=180 so a paragraph following a shaded region keeps its margin.
# ShadedTable shades a table-only region directly: through the div the
# block shading would vanish and the writer would leave the following
# paragraph in BodyText with no margin below the table.
--- a/word/styles.xml
+++ b/word/styles.xml
@@ -704,4 +704,27 @@
       <w:color w:val="000000" />
     </w:rPr>
   </w:style>
+  <w:style w:type="paragraph" w:styleId="ShadingBlock">
+    <w:name w:val="ShadingBlock" />
+    <w:basedOn w:val="BodyText" />
+    <w:qFormat />
+    <w:pPr>
+      <w:shd w:val="clear" w:color="auto" w:fill="FFF3CD" />
+      <w:spacing w:after="180" />
+    </w:pPr>
+  </w:style>
+  <w:style w:type="character" w:styleId="ShadingInline">
+    <w:name w:val="ShadingInline" />
+    <w:qFormat />
+    <w:rPr>
+      <w:shd w:val="clear" w:color="auto" w:fill="FFF3CD" />
+    </w:rPr>
+  </w:style>
+  <w:style w:type="table" w:customStyle="1" w:styleId="ShadedTable">
+    <w:name w:val="ShadedTable" />
+    <w:basedOn w:val="Table" />
+    <w:tblPr>
+      <w:shd w:val="clear" w:color="auto" w:fill="FFF3CD" />
+    </w:tblPr>
+  </w:style>
 </w:styles>
